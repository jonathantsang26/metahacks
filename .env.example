# Copy to .env (gitignored) and fill in. Never commit real keys.

# Meta Model API (https://dev.meta.ai): muse-spark-1.3 and sam-3.1. Used by the pipeline and web/api/analyst.
MODEL_API_KEY=

# NASA FIRMS area API key (free, emailed): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Analyst spend cap (web/api/_lib/budget.ts). Meta has no hard spend limit, so the app enforces one.
# The Upstash Redis store's variables come from the Vercel Marketplace integration
# (`cd web && vercel env pull` writes them to web/.env.local, which the scripts and dev server read).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Cap in USD, default 100, never above 150.
# ANALYST_BUDGET_USD=100
# Set to 1 only for an untracked local run without the shared store.
# ANALYST_BUDGET_LOCAL=
